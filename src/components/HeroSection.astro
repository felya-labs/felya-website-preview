---
import { gloveLightImage, gloveDarkImage } from '../data/site.js';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/translations';

const { locale } = Astro.props as { locale: Locale };

const gloveSrcset = gloveDarkImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                     ');
const gloveCutoutSrcset = gloveLightImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                     ');
---

<section id="paton" class="hero-reveal hero-section">
    <div class="hero-globe" data-globe="a" aria-hidden="true">
        <div class="hero-globe__stage">
            <div class="hero-globe__sphere">
                <span class="hero-globe__meridian" style="--n:0"></span>
                <span class="hero-globe__meridian" style="--n:1"></span>
                <span class="hero-globe__meridian" style="--n:2"></span>
                <span class="hero-globe__meridian" style="--n:3"></span>
                <span class="hero-globe__meridian" style="--n:4"></span>
                <span class="hero-globe__meridian" style="--n:5"></span>
                <span class="hero-globe__meridian" style="--n:6"></span>
                <span class="hero-globe__parallel" style="--offset:1"></span>
                <span class="hero-globe__parallel" style="--offset:2"></span>
                <span class="hero-globe__parallel" style="--offset:-1"></span>
                <span class="hero-globe__parallel" style="--offset:-2"></span>
            </div>
            <svg class="hero-globe__pulses" viewBox="-200 -200 400 400" preserveAspectRatio="xMidYMid meet">
                <path id="hero-globe-pulse-path-1" d="M -170 0 A 170 60 0 1 1 170 0 A 170 60 0 1 1 -170 0 Z"></path>
                <path id="hero-globe-pulse-path-2" d="M 0 -170 A 92 170 0 1 1 0 170 A 92 170 0 1 1 0 -170 Z"></path>
                <path id="hero-globe-pulse-path-3" d="M -170 0 A 170 108 0 1 1 170 0 A 170 108 0 1 1 -170 0 Z"></path>
                <circle class="hero-globe__pulse" r="2.6">
                    <animateMotion dur="6.5s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#hero-globe-pulse-path-1"></mpath>
                    </animateMotion>
                </circle>
                <circle class="hero-globe__pulse" r="2.6">
                    <animateMotion dur="8s" begin="-3s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#hero-globe-pulse-path-2"></mpath>
                    </animateMotion>
                </circle>
                <circle class="hero-globe__pulse hero-globe__pulse--gold" r="3.2">
                    <animateMotion dur="9s" begin="-5s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#hero-globe-pulse-path-3"></mpath>
                    </animateMotion>
                </circle>
            </svg>
        </div>
    </div>
    <div class="hero-composition">
        <div class="hero-copy">
            <p class="hero-product-name" data-i18n="hero.product">{t(locale, 'hero.product')}</p>
            <h1 class="hero-title">
                <span class="block text-white" data-i18n="hero.headlineHands">{t(locale, 'hero.headlineHands')}</span>
                <span class="hero-headline-language-hitbox text-[#777777]" data-hero-headline-languages data-hero-intro-pending
                      role="button" tabindex="0" aria-label={t(locale, 'hero.languageInteraction')}>
                    <span class="hero-headline-language-reference" data-i18n="hero.headlineAnywhere"
                          aria-hidden="true">{t(locale, 'hero.headlineAnywhere')}</span>
                    <span class="hero-headline-language-text" data-i18n="hero.headlineAnywhere">{t(locale, 'hero.headlineAnywhere')}</span>
                </span>
            </h1>
            <p class="hero-lead" data-i18n="hero.lead">
                {t(locale, 'hero.lead')}
            </p>

        </div>

        <div class="hero-product-stage hero-mobile-glove-stage">
            <div class="hero-product-composite hero-scroll-glove" data-hero-product-composite>
                <img src={gloveLightImage.src}
                     srcset={gloveCutoutSrcset}
                     sizes="(min-width: 1280px) 540px, (min-width: 1024px) 460px, (min-width: 640px) 430px, calc(100vw - 48px)"
                     width={gloveLightImage.width} height={gloveLightImage.height}
                     alt={t(locale, 'hero.imageAlt')} loading="eager" decoding="async" fetchpriority="high"
                     class="hero-product-image hero-product-image--light">
                <img src={gloveDarkImage.src}
                     srcset={gloveSrcset}
                     sizes="(min-width: 1280px) 540px, (min-width: 1024px) 460px, (min-width: 640px) 430px, calc(100vw - 48px)"
                     width={gloveDarkImage.width} height={gloveDarkImage.height}
                     alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high"
                     class="hero-product-image hero-product-image--dark">
            </div>
        </div>
    </div>

    {/* TEMP: preview-comparison switcher — remove before merging this redesign to main */}
    <div class="hero-globe-switcher" data-hero-globe-switcher aria-label="Hero-Globus-Variante (Vergleich)">
        <button type="button" data-globe-option="a">A · Blueprint</button>
        <button type="button" data-globe-option="b">B · Signalnetz</button>
        <button type="button" data-globe-option="c">C · Subliminal</button>
        <button type="button" data-globe-option="off">Aus</button>
    </div>
</section>

<script>
    const STORAGE_KEY = 'felya-hero-globe-variant';
    const globe = document.querySelector<HTMLElement>('.hero-globe');
    const switcher = document.querySelector<HTMLElement>('[data-hero-globe-switcher]');

    if (globe && switcher) {
        const applyVariant = (variant: string) => {
            if (variant === 'off') {
                globe.setAttribute('data-globe', 'off');
            } else {
                globe.setAttribute('data-globe', variant);
            }
            switcher.querySelectorAll<HTMLButtonElement>('button').forEach((btn) => {
                btn.setAttribute('aria-pressed', String(btn.dataset.globeOption === variant));
            });
        };

        const stored = localStorage.getItem(STORAGE_KEY) ?? 'a';
        applyVariant(stored);

        switcher.addEventListener('click', (event) => {
            const target = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-globe-option]');
            if (!target?.dataset.globeOption) return;
            localStorage.setItem(STORAGE_KEY, target.dataset.globeOption);
            applyVariant(target.dataset.globeOption);
        });
    }
</script>
