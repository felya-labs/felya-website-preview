---
import { gloveCutoutImage, gloveImage } from '../data/site.js';

const gloveSrcset = gloveImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                     ');
const gloveCutoutSrcset = gloveCutoutImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                     ');
---

<section
        class="relative grid min-h-[700px] grid-cols-1 items-center gap-12 px-8 pb-12 pt-32 md:min-h-[calc(100svh-1rem)] md:px-16 md:pb-16 md:pt-36 lg:grid-cols-[0.96fr_1.04fr] lg:gap-14 2xl:mx-auto 2xl:max-w-[104rem] 2xl:gap-10 2xl:px-10">

    <div class="z-10 flex w-full flex-col justify-center py-4 md:ml-8 md:py-8 lg:ml-10 2xl:ml-0">
        <div class="mx-auto flex w-full max-w-[42rem] flex-col justify-center md:mx-0 lg:max-w-[44rem]">

            <div class="max-w-full space-y-8">
                <div class="space-y-5">
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-500" data-i18n="hero.eyebrow">Wearable teleoperation</p>
                    <h1 class="max-w-[44rem] text-[2.95rem] font-bold leading-[0.94] tracking-tight text-white sm:text-[4.35rem] md:text-[5rem] lg:text-[5.45rem] xl:text-[5.65rem]">
                        <span class="block" data-i18n="hero.headlineHands">Your hands.</span>
                        <span class="block text-gray-300" data-i18n="hero.headlineArms">Your arms.</span>
                        <span class="block text-[#777777]" data-i18n="hero.headlineAnywhere">Anywhere.</span>
                    </h1>
                </div>
                <p class="max-w-[42rem] text-lg font-semibold leading-relaxed text-gray-300 sm:text-xl md:text-2xl" data-i18n="hero.lead">
                    PATON turns natural human movement into robotic action, while physical feedback returns to the person in control.
                </p>
                <p class="max-w-[30rem] text-[0.98rem] leading-relaxed text-gray-500 md:text-base" data-i18n="hero.subline">
                    Interface for remote robotic work.
                </p>
            </div>

            <div class="hero-product-stage hero-mobile-glove-stage relative mt-16 flex h-[34vh] min-h-[255px] max-h-[360px] w-full items-center justify-center md:hidden">
                <img src={gloveImage.src} srcset={gloveSrcset} sizes={gloveImage.sizes}
                     width={gloveImage.width} height={gloveImage.height} alt={gloveImage.alt} loading="eager"
                     decoding="async" fetchpriority="high"
                     class="hero-product-image hero-product-image--dark hero-scroll-glove h-full w-auto max-w-full object-contain">
                <img src={gloveCutoutImage.src} srcset={gloveCutoutSrcset} sizes={gloveCutoutImage.sizes}
                     width={gloveCutoutImage.width} height={gloveCutoutImage.height} alt={gloveCutoutImage.alt} loading="eager"
                     decoding="async"
                     class="hero-product-image hero-product-image--light hero-scroll-glove h-full w-auto max-w-full object-contain">
            </div>
        </div>
    </div>

    <div class="hero-product-stage relative mt-0 hidden h-[56vh] min-h-[400px] w-full items-center justify-center md:flex lg:h-[70vh] lg:max-h-[700px] xl:max-h-[740px]">
        <img src={gloveImage.src} srcset={gloveSrcset} sizes={gloveImage.sizes}
             width={gloveImage.width} height={gloveImage.height} alt={gloveImage.alt} loading="eager"
             decoding="async" fetchpriority="high"
             class="hero-product-image hero-product-image--dark hero-scroll-glove h-full w-auto max-w-full object-contain rotate-[2deg] scale-105">
        <img src={gloveCutoutImage.src} srcset={gloveCutoutSrcset} sizes={gloveCutoutImage.sizes}
             width={gloveCutoutImage.width} height={gloveCutoutImage.height} alt={gloveCutoutImage.alt} loading="eager"
             decoding="async"
             class="hero-product-image hero-product-image--light hero-scroll-glove h-full w-auto max-w-full object-contain rotate-[2deg] scale-105">
    </div>
</section>
