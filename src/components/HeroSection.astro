---
import { gloveLightImage, gloveDarkImage } from '../data/site.js';
import { heroEarthPath, heroEarthLimbPath, heroEarthClipPath, heroEarthOuterClipPath, heroEarthViewBox } from '../data/hero-earth-coastline.js';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/translations';

const { locale } = Astro.props as { locale: Locale };

const gloveSrcset = gloveDarkImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                     ');
const gloveCutoutSrcset = gloveLightImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                     ');

// Atmosphere glow: stacked strokes (widest/faintest first, painted back-to-front) instead of a
// true gradient -- see the comment where this is used for why a linearGradient paint doesn't
// work against a curve with this much y-range. Geometric progression in both width and opacity
// approximates a smooth falloff. Verify any future change to this at true page scale, not a
// magnified crop -- an earlier pass at 46px read fine zoomed-in but was actually 15%+ of the
// whole earth strip's height, looking like a bold ring rather than a haze.
// These base numbers are intentionally modest: the hero-atmosphere-mask below (a cursor-linked
// hotspot, see initHeroAtmosphereHotspot in site.js) fades the ring to fully invisible away
// from the brightest point -- only a small neighborhood around the cursor ever reads at close
// to full strength, and the whole group starts hidden until the cursor moves over the section
// at all (see .hero-earth__horizon-glow-group in global.css).
const heroAtmosphereLayers = [
    { width: 8, opacity: 0.014 },
    { width: 6, opacity: 0.032 },
    { width: 4.2, opacity: 0.058 },
    { width: 3, opacity: 0.095 },
    { width: 2, opacity: 0.15 },
    { width: 1.3, opacity: 0.23 },
];
---

<section id="paton" class="hero-reveal hero-section">
    <div class="hero-starfield" aria-hidden="true"></div>
    <div class="hero-earth" aria-hidden="true">
        <div class="hero-earth__glow"></div>
        <svg class="hero-earth__horizon" viewBox={heroEarthViewBox} preserveAspectRatio="xMidYMin slice">
            <defs>
                <clipPath id="hero-earth-clip" clipPathUnits="userSpaceOnUse">
                    <path d={heroEarthClipPath} />
                </clipPath>
                <clipPath id="hero-earth-clip-outer" clipPathUnits="userSpaceOnUse">
                    <path d={heroEarthOuterClipPath} />
                </clipPath>
                <!-- The atmosphere isn't uniformly bright around the limb -- it's a spotlight that
                     only exists near the cursor and fades to fully transparent (stop-opacity 0,
                     not just faint) a short distance away, so away from the cursor there's no
                     atmosphere to see at all. That point drifts gently with the cursor
                     (initHeroAtmosphereHotspot in site.js eases this gradient's cx toward the
                     pointer's x, it doesn't snap to it) and its radius (the r attribute) is set
                     by the same script -- tight while chasing the cursor so the extent has to be
                     discovered by moving it, wider and centered on devices with no cursor to
                     chase (touch, reduced-motion), where the whole group falls back to a static
                     always-on look instead (see .hero-earth__horizon-glow-group in global.css).
                     Plain white with only stop-opacity varying: against a luminance mask that
                     makes the effective alpha exactly the stop-opacity value, with no
                     tint-dependent luminance math to account for. -->
                <radialGradient id="hero-atmosphere-hotspot" gradientUnits="userSpaceOnUse" cx="0" cy="-85" r="90">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                    <stop offset="40%" stop-color="#ffffff" stop-opacity="0.55" />
                    <stop offset="70%" stop-color="#ffffff" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                </radialGradient>
                <mask id="hero-atmosphere-mask" maskUnits="userSpaceOnUse" x="-100" y="-100" width="200" height="30">
                    <rect x="-100" y="-100" width="200" height="30" fill="url(#hero-atmosphere-hotspot)" />
                </mask>
            </defs>
            <!-- A real linearGradient paint (tried first) doesn't work here: it fades against
                 fixed absolute y-coordinates, but the limb curve's own y ranges from -70 (edges)
                 to -100 (pole) -- far wider than any one fade distance -- so large stretches of
                 the curve rendered outside the gradient's y1/y2 span just clamp to a flat
                 stop color instead of fading, producing a hard-edged band rather than a soft
                 glow. Many finely-graduated flat-opacity strokes (geometric width/opacity
                 progression) sidesteps that: each is clip-independent of position along the
                 curve, and enough of them (6 here) makes the steps between layers small
                 enough to read as a continuous falloff rather than visible bands. -->
            <g class="hero-earth__horizon-glow-group" mask="url(#hero-atmosphere-mask)">
                {heroAtmosphereLayers.map(({ width, opacity }) => (
                    <path d={heroEarthLimbPath} clip-path="url(#hero-earth-clip-outer)"
                          style={`stroke-width:${width}px; opacity:${opacity};`} />
                ))}
            </g>
            <path d={heroEarthLimbPath} clip-path="url(#hero-earth-clip)" />
        </svg>
        <div class="hero-earth__orb">
            <svg class="hero-earth__coastline" viewBox={heroEarthViewBox} preserveAspectRatio="xMidYMin slice">
                <path d={heroEarthPath} clip-path="url(#hero-earth-clip)" />
            </svg>
        </div>
    </div>
    <div class="hero-composition">
        <div class="hero-copy">
            <div class="hero-copy-align">
                <p class="hero-product-name" data-i18n="hero.product">{t(locale, 'hero.product')}</p>
                <h1 class="hero-title">
                    <span class="block text-white" data-i18n="hero.headlineHands">{t(locale, 'hero.headlineHands')}</span>
                    <span class="hero-headline-language-hitbox text-[#777777]" data-hero-headline-languages data-hero-intro-pending
                          role="button" tabindex="0" aria-label={t(locale, 'hero.languageInteraction')}>
                        <span class="hero-headline-language-reference" data-i18n="hero.headlineAnywhere"
                              aria-hidden="true">{t(locale, 'hero.headlineAnywhere')}</span>
                        <span class="hero-headline-language-text" data-i18n="hero.headlineAnywhere">{t(locale, 'hero.headlineAnywhere')}</span>
                    </span>
                </h1>
                <p class="hero-lead" data-i18n="hero.lead">
                    {t(locale, 'hero.lead')}
                </p>
            </div>
        </div>

        <div class="hero-product-stage hero-mobile-glove-stage">
            <div class="hero-product-composite hero-scroll-glove" data-hero-product-composite>
                <img src={gloveLightImage.src}
                     srcset={gloveCutoutSrcset}
                     sizes="(min-width: 1280px) 540px, (min-width: 1024px) 460px, (min-width: 640px) 430px, calc(100vw - 48px)"
                     width={gloveLightImage.width} height={gloveLightImage.height}
                     alt={t(locale, 'hero.imageAlt')} loading="eager" decoding="async" fetchpriority="high"
                     class="hero-product-image hero-product-image--light">
                <img src={gloveDarkImage.src}
                     srcset={gloveSrcset}
                     sizes="(min-width: 1280px) 540px, (min-width: 1024px) 460px, (min-width: 640px) 430px, calc(100vw - 48px)"
                     width={gloveDarkImage.width} height={gloveDarkImage.height}
                     alt="" aria-hidden="true" loading="eager" decoding="async" fetchpriority="high"
                     class="hero-product-image hero-product-image--dark">
            </div>
        </div>
    </div>
</section>
