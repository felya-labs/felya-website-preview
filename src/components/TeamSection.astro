---
import { teamImage } from '../data/site.js';

const teamSrcset = teamImage.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                        ');
const capabilities = [
  { key: 'mechanical', label: 'Mechanical systems' },
  { key: 'wearable', label: 'Wearable robotics' },
  { key: 'embedded', label: 'Embedded electronics' },
  { key: 'software', label: 'Software' },
  { key: 'interaction', label: 'Human-centered interaction' }
];
---

<section id="team" class="flex flex-col items-center px-8 py-16 md:px-16">
    <div class="text-center mb-16 space-y-4">
        <h2 class="text-white text-2xl md:text-2xl font-bold tracking-tight">
            <span data-i18n="team.heading">Built at the intersection of human skill and robotics.</span>
        </h2>
        <div class="inline-block bg-[#111111] border border-[#222] rounded-full px-5 py-2 text-gray-400 text-sm font-medium" data-i18n="team.bubble">
            Early-stage venture | Cologne, Germany
        </div>
    </div>

    <div class="grid w-full max-w-[1200px] grid-cols-1 items-center gap-16 md:grid-cols-2 2xl:max-w-[104rem] 2xl:gap-20">
        <div class="w-full">
            <img
                    src={teamImage.src}
                    srcset={teamSrcset}
                    sizes={teamImage.sizes}
                    width={teamImage.width}
                    height={teamImage.height}
                    loading="lazy"
                    decoding="async"
                    alt={teamImage.alt}
                    class="surface-corners w-full h-auto object-cover border border-[#111]">
        </div>
        <div class="space-y-6 text-gray-400 text-lg leading-relaxed">
            <p data-i18n="team.origin">
                FELYA LABS emerged from the <strong class="text-white font-semibold">Code & Context</strong>{' '}
                program at <strong class="text-white font-semibold">TH Köln</strong>.
            </p>
            <p data-i18n="team.prototypes">
                The current PATON system builds on earlier glove-based prototypes developed through academic research,
                hands-on testing and industry-supported iteration.
            </p>
            <p data-i18n="team.system">
                We are developing PATON as a modular wearable teleoperation system, starting with the PATON Glove for
                hand motion and physical feedback and expanding toward the PATON Suit for arm and body-level control.
            </p>
            <p data-i18n="team.focus">
                Our current focus is a bilateral demonstrator that transfers natural motion to robotic arms and hands,
                with contact and force cues sent back to the operator.
            </p>
            <div class="flex flex-wrap gap-2 pt-2" aria-label="FELYA LABS capabilities" data-i18n-aria-label="team.capabilitiesAria">
                {capabilities.map((capability) => (
                    <span class="rounded-full border border-[#222] bg-[#111111] px-4 py-2 text-sm font-medium text-gray-400" data-i18n={`team.capabilities.${capability.key}`}>
                        {capability.label}
                    </span>
                ))}
            </div>
        </div>
    </div>
</section>
