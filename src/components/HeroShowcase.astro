---
import HeroSection from './HeroSection.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/translations';
import '../styles/cinematic-hero.css';
const { locale } = Astro.props as { locale: Locale };
---
<div class="hero-showcase" data-hero-variant="cinematic">
    <section class="cinematic-hero" aria-label={t(locale, 'hero.cinematic')}>
        <div class="cinematic-hero__composition">
            <div class="cinematic-hero__copy">
                <p class="cinematic-hero__eyebrow">{t(locale, 'hero.product')}</p>
                <h1 lang="en" aria-label="Your hands. Anywhere on Earth."><span>Your hands.</span><span>Anywhere</span><span>on Earth.</span></h1>
                <p class="cinematic-hero__lead" data-i18n="hero.lead">{t(locale, 'hero.lead')}</p>
                <a href="mailto:info@felya.com" class="cinematic-hero__contact"><span data-i18n="nav.contact">{t(locale, 'nav.contact')}</span><span aria-hidden="true">↗</span></a>
            </div>
            <div class="cinematic-hero__film" data-film-state="poster">
                <img src="/assets/video/cinematic-hero/b2-poster.jpg" width="900" height="656" alt={t(locale, 'hero.imageAlt')} data-i18n-alt="hero.imageAlt" decoding="async" fetchpriority="high" />
                <video muted autoplay loop playsinline preload="none" poster="/assets/video/cinematic-hero/b2-poster.jpg" width="900" height="656" aria-hidden="true" tabindex="-1" data-desktop="/assets/video/cinematic-hero/b2-desktop.mp4" data-mobile="/assets/video/cinematic-hero/b2-mobile.mp4"></video>
            </div>
        </div>
        <button type="button" class="cinematic-hero__play" data-film-toggle aria-label={t(locale, 'hero.play')}><span data-film-icon aria-hidden="true">▷</span><span data-film-label>{t(locale, 'hero.play')}</span></button>
    </section>
    <div class="hero-classic" data-hero-inactive inert aria-hidden="true"><HeroSection locale={locale} /></div>
    <div class="hero-variant-controls">
        <span data-hero-count aria-hidden="true">01 / 02</span>
        <span class="sr-only" data-hero-announcement aria-live="polite">{t(locale, 'hero.cinematic')}</span>
        <button type="button" data-hero-previous aria-label={t(locale, 'hero.previous')} data-i18n-aria-label="hero.previous"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5m6-6-6 6 6 6" /></svg></button>
        <button type="button" data-hero-next aria-label={t(locale, 'hero.next')} data-i18n-aria-label="hero.next"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
    </div>
</div>
