---
import HeroSection from './HeroSection.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/translations';
import '../styles/cinematic-hero.css';
const { locale } = Astro.props as { locale: Locale };
// Phase 2 (Preview): the film hero follows the site's own style (theme colours, section type, framed media like the
// prototype film) and switches with the globe hero by a horizontal swipe. Film: docs/cinematic-hero-media.json.
---
<div class="hero-showcase" data-hero-variant="cinematic">
    <section class="cinematic-hero film-hero" aria-labelledby="film-hero-title">
        <div class="film-hero__layout">
            <div class="film-hero__copy">
                <p class="section-kicker" data-i18n="hero.product">{t(locale, 'hero.product')}</p>
                <h1 id="film-hero-title" class="film-hero__title" data-i18n="hero.filmClaim">{t(locale, 'hero.filmClaim')}</h1>
                <p class="film-hero__lead" data-i18n="hero.lead">{t(locale, 'hero.lead')}</p>
                <div class="film-hero__actions">
                    <a href="mailto:info@felya.com" class="film-hero__primary"><span data-i18n="nav.contact">{t(locale, 'nav.contact')}</span></a>
                    <a href="#system" class="film-hero__secondary"><span data-i18n="hero.howItWorks">{t(locale, 'hero.howItWorks')}</span><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>
                </div>
            </div>
            <div class="film-hero__stage cinematic-hero__film" data-film-state="poster">
                <picture>
                    <source media="(max-width: 720px)" srcset="/assets/video/cinematic-hero/craft-poster-mobile.jpg" width="640" height="640" />
                    <img src="/assets/video/cinematic-hero/craft-poster.jpg" width="1280" height="720" alt={t(locale, 'hero.imageAlt')} data-i18n-alt="hero.imageAlt" decoding="async" fetchpriority="high" />
                </picture>
                <video muted playsinline preload="none" width="1280" height="720" aria-hidden="true" tabindex="-1" data-active data-clip="craft" data-desktop="/assets/video/cinematic-hero/craft-desktop.mp4" data-mobile="/assets/video/cinematic-hero/craft-mobile.mp4"></video>
                <button type="button" class="film-hero__toggle cinematic-hero__play" data-film-toggle data-lens-surface aria-label={t(locale, 'hero.pause')}>
                    <svg class="film-hero__ring" aria-hidden="true" viewBox="0 0 40 40"><circle cx="20" cy="20" r="18.25" pathLength="100" /></svg>
                    <span class="film-hero__icon" data-film-icon aria-hidden="true">
                        <svg class="film-hero__icon-pause" viewBox="0 0 16 16" width="14" height="14"><rect x="3.5" y="2.5" width="3" height="11" rx="1" /><rect x="9.5" y="2.5" width="3" height="11" rx="1" /></svg>
                        <svg class="film-hero__icon-play" viewBox="0 0 16 16" width="14" height="14"><path d="M5 2.9v10.2a.8.8 0 0 0 1.2.7l8-5.1a.8.8 0 0 0 0-1.4l-8-5.1A.8.8 0 0 0 5 2.9Z" /></svg>
                    </span>
                    <span class="sr-only" data-film-label>{t(locale, 'hero.pause')}</span>
                </button>
            </div>
        </div>
    </section>
    <div class="hero-classic" data-hero-inactive inert aria-hidden="true"><HeroSection locale={locale} /></div>
    <!-- Switching: arrows appear when the pointer is over the hero (or on keyboard focus); touch swipes, the dots
         always show where you are on touch screens and with the arrows on pointer screens. -->
    <button type="button" class="hero-arrow hero-arrow--previous" data-hero-step="-1" aria-label={t(locale, 'hero.previous')} data-i18n-aria-label="hero.previous">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5 8 12l6.5 6.5" /></svg>
    </button>
    <button type="button" class="hero-arrow hero-arrow--next" data-hero-step="1" aria-label={t(locale, 'hero.next')} data-i18n-aria-label="hero.next">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 5.5 16 12l-6.5 6.5" /></svg>
    </button>
    <div class="hero-dots" role="radiogroup" aria-label={t(locale, 'hero.variants')} data-i18n-aria-label="hero.variants">
        <button type="button" role="radio" aria-checked="true" data-hero-option="cinematic" aria-label={t(locale, 'hero.variantFilm')}><span aria-hidden="true"></span></button>
        <button type="button" role="radio" aria-checked="false" data-hero-option="classic" aria-label={t(locale, 'hero.variantGlobe')}><span aria-hidden="true"></span></button>
    </div>
    <span class="sr-only" data-hero-announcement aria-live="polite"></span>
</div>
