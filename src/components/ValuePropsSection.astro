---
const valueProps = [
  {
    number: '01',
    icon: 'control',
    key: 'natural',
    title: 'Natural control',
    description: 'Arm, hand and finger movement become direct control signals for robotic systems.'
  },
  {
    number: '02',
    icon: 'feedback',
    key: 'feedback',
    title: 'Physical feedback',
    description: 'Physical feedback helps operators understand contact, resistance and interaction.'
  },
  {
    number: '03',
    icon: 'remote',
    key: 'remote',
    title: 'Remote manipulation',
    description: "Human dexterity can reach tasks and environments beyond the operator's body."
  }
];

const controlLoop = [
  'Human movement',
  'Robotic action',
  'Physical feedback'
];
---

<section class="px-8 pb-20 pt-2 md:px-16 md:pb-28 md:pt-0" aria-labelledby="principles-heading">
    <div class="mx-auto w-full max-w-[82rem] 2xl:max-w-[104rem]">
        <header class="grid gap-5 border-t border-[#181818] pt-8 md:grid-cols-[0.85fr_1.15fr] md:gap-12 md:pt-10">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-500" data-i18n="system.eyebrow">PATON system</p>
                <h2 id="principles-heading" class="mt-4 max-w-[34rem] text-[2.2rem] font-bold leading-[1.03] tracking-tight text-white sm:text-[2.8rem] md:text-[3rem]">
                    <span data-i18n="system.heading">Built for natural teleoperation.</span>
                </h2>
            </div>
            <p class="max-w-[42rem] text-lg font-medium leading-relaxed text-gray-400 md:pt-10 md:text-xl" data-i18n="system.lead">
                PATON connects motion capture, robotic control and haptic feedback into one physical control loop for remote manipulation.
            </p>
        </header>

        <div class="control-loop-strip mt-8 grid gap-3 rounded-[1.5rem] border border-[#202020] bg-[#0d0d0d] p-3 md:mt-10 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-center md:p-4">
            {controlLoop.map((item, index) => (
                <>
                    <div class="control-loop-step flex min-h-16 items-center justify-center rounded-[1.1rem] border border-[#202020] bg-black/30 px-4 text-center text-sm font-semibold text-gray-300 md:min-h-20 md:text-base" data-i18n={`system.loop.${index}`}>
                        {item}
                    </div>
                    {index < controlLoop.length - 1 && (
                        <div class="control-loop-arrow flex items-center justify-center text-gray-600" aria-hidden="true">
                            <svg class="hidden h-5 w-8 md:block" viewBox="0 0 32 20" fill="none">
                                <path d="M2 10h25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                <path d="m22 4 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <svg class="h-7 w-5 md:hidden" viewBox="0 0 20 32" fill="none">
                                <path d="M10 2v25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                <path d="m4 22 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    )}
                </>
            ))}
        </div>

        <div class="mt-8 grid grid-cols-1 gap-4 md:mt-10 md:grid-cols-3 md:gap-5">
            {valueProps.map((item) => (
                <article class="group rounded-[1.5rem] border border-[#202020] bg-[#0d0d0d] p-6 transition-colors duration-300 hover:border-[#343434] hover:bg-[#111] md:min-h-[17rem] md:p-7">
                    <div class="flex items-start justify-between gap-6">
                        <div class="value-prop-icon flex h-12 w-12 items-center justify-center rounded-2xl border border-[#272727] bg-black text-gray-300 transition-colors duration-300 group-hover:border-[#3a3a3a] group-hover:text-white">
                            {item.icon === 'control' && (
                                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-none stroke-current stroke-[1.6]">
                                    <path d="M4 13.5c2.4-4.2 5.1-6.3 8-6.3s5.6 2.1 8 6.3" />
                                    <path d="M8.5 13.5c1.1-1.8 2.3-2.7 3.5-2.7s2.4.9 3.5 2.7" />
                                    <path d="M12 17.8v-4.2" />
                                    <path d="M6.5 18.2h11" />
                                </svg>
                            )}
                            {item.icon === 'feedback' && (
                                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-none stroke-current stroke-[1.6]">
                                    <path d="M3.5 12h3l2-5.5 3.2 11 2.6-7.5 1.5 2h4.7" />
                                    <path d="M5.5 18.5c3.4 2.4 9.6 2.4 13 0" />
                                    <path d="M5.5 5.5c3.4-2.4 9.6-2.4 13 0" />
                                </svg>
                            )}
                            {item.icon === 'remote' && (
                                <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-none stroke-current stroke-[1.6]">
                                    <path d="M5 17.5 10.5 12 5 6.5" />
                                    <path d="M19 6.5 13.5 12l5.5 5.5" />
                                    <path d="M9 12h6" />
                                    <path d="M4 4h4" />
                                    <path d="M16 20h4" />
                                </svg>
                            )}
                        </div>
                        <span class="text-xs font-semibold tracking-[0.18em] text-gray-600">{item.number}</span>
                    </div>
                    <h3 class="mt-8 text-xl font-semibold tracking-tight text-white" data-i18n={`system.props.${item.key}.title`}>{item.title}</h3>
                    <p class="mt-4 max-w-[22rem] text-[0.96rem] leading-relaxed text-gray-500" data-i18n={`system.props.${item.key}.description`}>{item.description}</p>
                </article>
            ))}
        </div>
    </div>
</section>
