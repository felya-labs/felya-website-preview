---
import { iterationVideo as defaultVideo } from '../data/site.js';

const {
  id = 'iteration',
  heading = 'Built through testing. Refined through touch.',
  description = 'We started with finger motion. Then we learned what was missing: touch. PATON is now developed through prototypes that test motion capture, robotic control and physical feedback as one connected system.',
  proofPoints = ['Motion capture', 'Robotic control', 'Physical feedback'],
  video = defaultVideo,
  playerId = 'prototype-video'
} = Astro.props;

const headingId = `${id}-heading`;
const coverSrcset = video.cover?.srcset.map(([src, width]) => `${src} ${width}w`).join(',\n                            ');
---

<section id={id} class="px-8 md:px-16 pt-20 pb-36 flex flex-col items-center" aria-labelledby={headingId}>
    <div class="mb-12 flex max-w-[760px] flex-col items-center gap-5 text-center">
        <h2 id={headingId} class="text-2xl font-bold tracking-tight text-white md:text-3xl">
            <span data-i18n="iteration.heading">{heading}</span>
        </h2>
        <p class="text-base leading-relaxed text-gray-500 md:text-lg" data-i18n="iteration.description">
            {description}
        </p>
        <div class="flex flex-wrap justify-center gap-2" aria-label="Prototype focus areas" data-i18n-aria-label="iteration.proofAria">
            {proofPoints.map((proofPoint, index) => (
                <span class="rounded-full border border-[#222] bg-[#111111] px-4 py-2 text-sm font-medium text-gray-400" data-i18n={`iteration.proof.${index}`}>
                    {proofPoint}
                </span>
            ))}
        </div>
    </div>

    <div data-video-frame class="video-ambient-frame surface-corners relative mx-auto aspect-video w-full max-w-[1100px] overflow-hidden border border-[#2a2a2a] bg-black 2xl:max-w-[80rem]">
        <video
                id={playerId}
                class="h-full w-full bg-black object-cover"
                controls
                controlslist="nodownload"
                playsinline
                preload={video.preload}
                poster={video.cover?.poster}
                width={video.width}
                height={video.height}
                aria-label={video.title}>
            {video.sources.map((source) => (
                <source data-src={source.src} type={source.type} media={source.media}>
            ))}
            {video.fallbackText}
        </video>
        <div data-video-starting class="video-starting-cue absolute left-1/2 top-1/2 z-20 hidden -translate-x-1/2 -translate-y-1/2 items-center justify-center gap-2 rounded-full border border-white/20 bg-black/45 px-5 py-4 shadow-[0_24px_80px_rgba(0,0,0,0.5)] backdrop-blur-md" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>
        {video.cover && (
            <button
                    type="button"
                    data-video-cover
                    data-video-target={playerId}
                    aria-controls={playerId}
                    aria-label={video.cover.label}
                    hidden
                    class="group absolute inset-0 z-10 flex h-full w-full cursor-pointer items-center justify-center bg-black text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black">
                <picture class="absolute inset-0 h-full w-full" aria-hidden="true">
                    <source srcset={coverSrcset} sizes={video.cover.sizes} type="image/webp">
                    <img
                            src={video.cover.src}
                            width={video.cover.width}
                            height={video.cover.height}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover">
                </picture>
                <span class="absolute inset-0 bg-black/10 transition-colors duration-300 group-hover:bg-black/5" aria-hidden="true"></span>
                <span data-video-play-cta class="video-play-cta relative z-10 inline-flex min-h-12 items-center gap-3 rounded-full border border-white/20 bg-white px-3 py-2 pr-5 text-sm font-semibold text-black shadow-[0_22px_70px_rgba(0,0,0,0.45)] transition-colors duration-300 md:min-h-18 md:gap-4 md:px-5 md:py-3 md:pr-8 md:text-lg md:group-hover:scale-[1.045] md:group-focus-visible:scale-[1.065]">
                    <span class="video-play-cta__icon flex h-8 w-8 items-center justify-center rounded-full bg-black text-white transition-colors duration-300 md:h-11 md:w-11">
                        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 md:h-5 md:w-5">
                            <path d="M8 5v14l11-7z"/>
                        </svg>
                    </span>
                    <span data-i18n="iteration.playButton">Play</span>
                </span>
            </button>
        )}
    </div>
</section>
